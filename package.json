{
  "name": "ra",
  "private": true,
  "description": "Ra, a voice-first wayfinder for autodidacts.",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @ra/web build && pnpm --filter @ra/worker dev",
    "dev:web": "pnpm --filter @ra/web dev",
    "dev:worker": "pnpm --filter @ra/worker dev"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
